# colcon
build/
install/
log/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Acceptance reports are run artifacts. CI uploads them; git does not
# keep them.
acceptance.json
acceptance.md

# Expanded URDFs are build artifacts, never sources. The YAML plus the
# xacro is the single source of truth; a committed URDF would drift.
*.urdf
!**/test/fixtures/*.urdf

# Secrets and environment. Config lives in Git, state lives on the server.
.env
*.env
!*.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Recorded datasets: large binary data, never in git.
#
# The DIRECTORY is tracked (via .gitkeep) even though its contents are
# not. compose.yml bind-mounts it, and Docker creates a missing bind
# source as root - which the container's non-root user then cannot write
# to. On a fresh clone that is a dataset recorder that fails on
# permissions for reasons having nothing to do with data.
# See docs/data-pipeline.md.
datasets/*
!datasets/.gitkeep
