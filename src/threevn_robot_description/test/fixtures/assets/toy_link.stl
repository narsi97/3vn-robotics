solid toy_link
  facet normal 0 0 1
    outer loop
      vertex 0.0 -0.01 0.0
      vertex 0.1 0.01 0.0
      vertex 0.1 -0.01 0.02
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0.0 0.01 0.02
      vertex 0.1 0.01 0.0
      vertex 0.0 -0.01 0.0
    endloop
  endfacet
endsolid toy_link
