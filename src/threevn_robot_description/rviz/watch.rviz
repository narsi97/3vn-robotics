# RViz for WATCHING a robot that is already running: `make watch`.
#
# view_arm.rviz is for inspecting a description: frame names on, the
# Displays panel open, a camera set close to the 3VN arm. This one is
# for looking at motion, and for recording it:
#
#   * no frame names or axes, which sit on top of the arm
#   * no side panels at all, so the picture is the robot. Asking RViz to
#     hide its docks did nothing without a saved window state; leaving
#     the panels out of the file does.
#   * fixed on base_link, a frame every arm here has, and a camera far
#     enough back to hold the longer SO-101 at full reach
#
# Like view_arm.rviz it reads the description from the TOPIC, so what it
# draws is whatever robot is running, on whichever backend.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 80; 80; 90
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Mass Properties:
        Inertia: false
        Mass: false
      TF Prefix: ""
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 38; 40; 46
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.85
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.14
      Pitch: 0.35
      Yaw: 0.95
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
  QMainWindow State: ""
