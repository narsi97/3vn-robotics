<?xml version="1.0"?>
<!--
  Minimal deterministic world: ground plane, one light, nothing else.

  Determinism matters because this world backs CI integration tests. Every
  extra object is another source of contact jitter and another reason for
  a test to fail for reasons unrelated to the robot.

  Physics: 1 ms step at real-time factor 1.0. The arm's links are small
  and light, so a larger step makes the gripper contacts unstable.
-->
<sdf version="1.10">
  <world name="grasp_bench">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required for ros_gz_bridge to see /clock and for controllers to
         run on simulation time. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!--
      The IMU system, which is what actually simulates a <sensor
      type="imu">.

      gz-sim-sensors-system above drives RENDERING sensors - cameras,
      depth, lidar. It does not touch an IMU, so without this the sensor
      parses, the bridge is created, and `gz topic -i` reports "No
      publishers on topic [/imu]": every layer looks configured and
      nothing produces a reading.
    -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.3 0.32 0.35 1</ambient>
            <diffuse>0.35 0.37 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      The thing the camera is here to find.

      GREEN, not red. The robot's own livery is orange
      (0.90 0.49 0.13), which in HSV sits close enough to red that a
      naive red threshold locks onto the arm instead of the target - and
      does it intermittently, as the arm swings through frame. Choosing a
      hue the robot does not wear removes a whole class of flaky test.
      test_the_robot_s_own_colours_are_not_detected keeps it that way.

      Size and pose are load bearing: the perception tests assert the
      detected position against these numbers, so changing them here
      changes what "correct" means.
    -->
    <!--
      A pedestal, because the floor is the worst place on this robot to
      pick something up.

      At ground level the arm is at full extension AND at the edge of
      its travel: solving for a grasp there puts shoulder_lift at 118
      degrees against a 120 degree limit, and it then settles 6 degrees
      short with the wrist 11 degrees short, missing by 43 mm. The same
      arm reaches poses higher up to under a millimetre. A heavy arm on
      hobby servos cannot hold itself at arm's length, and no amount of
      planning fixes that, so the object goes where the arm is strong.

      140 mm puts the cube 80 mm above the arm's base, 230 mm out, where
      37 approach angles work and the tightest joint still has 31
      degrees of margin.
    -->
    <model name="pedestal">
      <static>true</static>
      <pose>0.200 0 0.070 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.14</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      A cube the gripper can ACTUALLY hold, unlike target_cube.

      35 mm, because the jaw opens to about 45.7 mm between the finger
      inner faces: 51.7 mm between the finger origins, measured on the
      running robot, less 2 x 3 mm of finger. The 50 mm target_cube has
      never fitted, which is one of two reasons the pick_and_place
      scenario never picked anything up.

      NOT static, which is the other reason. target_cube is
      <static>true</static> and cannot be moved by contact at all, so a
      grasp of it could never have lifted anything.
    -->
    <model name="graspable_cube">
      <pose>0.200 0 0.1575 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>4.083e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.083e-6</iyy><iyz>0</iyz><izz>4.083e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.035 0.035 0.035</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.035 0.035 0.035</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.15 1</ambient>
            <diffuse>0.08 0.85 0.20 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
