# Copy to env/threevn-fleet.env on the VPS, fill in, chmod 600.
# Never commit the real file — config lives in Git, secrets live on the
# server only.

# Shared secret every robot presents as a bearer token. Generate with:
#   openssl rand -base64 48
#
# Without it the service still starts and still serves the view, but
# REFUSES every report rather than accepting unauthenticated writes from
# the internet. Failing closed matters more than convenience here.
FLEET_INGEST_TOKEN=

# The unlisted prefix Caddy strips before forwarding. Used only to build
# links in the page; routes are registered at the root.
FLEET_BASE_PATH=/fleet-fab0308e05e11b540b5324b1

# Port inside the container. The compose fragment publishes nothing —
# Caddy reaches it on the compose network, so this is never exposed
# directly.
PORT=8080
