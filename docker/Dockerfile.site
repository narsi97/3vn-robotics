# The course site: this repository's docs, rendered and served.
#
# A separate image from the dev container on purpose. The dev image is
# several GB of ROS and Gazebo; this is a few MB of HTML behind nginx,
# and the VPS it runs on has 2 GB of RAM and about ten containers on it
# already. Nothing here needs ROS, so nothing here carries it.
#
# Two stages: render with Python, serve with nginx. `markdown` is
# installed only in the build stage, which is why the dev image never
# grew a dependency for this.
FROM python:3.12-alpine AS build
RUN pip install --no-cache-dir markdown==3.7 pyyaml==6.0.2
WORKDIR /src
COPY docs ./docs
COPY VERSION ./
COPY course ./course
COPY scripts/build_site.py ./scripts/
# Not to run anything: the curriculum is validated against it, so a
# lesson naming a Make target that does not exist fails this build and
# the course already being served stays up.
COPY Makefile ./
# Passed in because .git is not copied into the build context: the
# footer states which commit the site was built from, and "unknown" in
# a published footer is worse than no footer.
ARG THREEVN_GIT_COMMIT=unknown
ENV THREEVN_GIT_COMMIT=${THREEVN_GIT_COMMIT}
RUN python3 scripts/build_site.py --root /src --out /site --clean

# The stable line, pinned: an unpinned tag changes under a rebuild.
FROM nginx:1.30-alpine
# Unlisted means unlisted. robots.txt comes from the generator; this
# adds the header form as well, since a crawler that ignores one may
# still honour the other.
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  add_header X-Robots-Tag "noindex, nofollow" always;\n\
  location / { try_files $uri $uri.html $uri/ =404; }\n\
  location = /tags { return 301 tags/; }\n\
  location ~ ^/tags/([a-z0-9-]+)$ { return 301 $1/; }\n\
}\n' > /etc/nginx/conf.d/default.conf
# The topic pages are the only directories: tags/ and tags/<slug>/. Asked
# for without the trailing slash, nginx's own redirect would be absolute
# and would drop the /robotics/ prefix Caddy strips before it gets here,
# sending the reader to a page that does not exist. The two locations
# above redirect RELATIVELY instead, so the browser keeps the prefix,
# whatever it is. The slash matters: the pages' links are relative.
COPY --from=build /site /usr/share/nginx/html
# apk upgrade: official base images lag Alpine's security fixes.
# Run as the image's own unprivileged `nginx` user: only the pid file and the
# cache dirs need to be writable, and Docker lets unprivileged processes in a
# container bind port 80.
RUN apk upgrade --no-cache \
 && sed -i '/^user /d' /etc/nginx/nginx.conf \
 && touch /run/nginx.pid \
 && chown -R nginx:nginx /var/cache/nginx /run/nginx.pid
USER nginx
EXPOSE 80
