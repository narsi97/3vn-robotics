root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,xacro,xml,yaml,yml,sdf,launch}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
# ament_flake8 sets max-line-length = 99
max_line_length = 99

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2
